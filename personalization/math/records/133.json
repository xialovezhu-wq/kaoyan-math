9bebdfcc519624eb4dc9d215d7be6e327bfe2875d05b47e60cdca70ebde90a8"}],"text":"*附件顺序（原消息）：题目图 `assets/Q03_81450_question.png`；解析图 `assets/Q03_81450_solution.png`。*\n\n这道题我选对了，我对 A、B 选项的导数很清楚。\n\n根号 $x$ 的导数应该等于 $2\\sqrt{x}$ 分之一乘以根号里面的数导一下，对吧？那它根号下 $x$ 乘以 $y$ 的绝对值，我先看 $x$ 大于 0 的情况下，它等于根号下 $x$ 乘以 $y$ 的绝对值，求导一下就等于 $2$ 倍根号下 $x$ 乘以 $y$ 的绝对值分之 $1$，然后就是 $x$ 乘以 $y$ 的绝对值求导，导完变成绝对值 $y$。\n\n为什么这道题分子上面带个根号呢？它根号不给它放上去，它是根号里面的东西导一下。A、B 选项这个答案写得是有问题！\n\n---\n\n<a id=\"m014\"></a>"},"source:1d74c33171acfd30d249b79f":{"association":"learning_material_not_personal_error","formal_id":null,"kind":"general_learning_material","labels":["圆锥面","多元函数积分学","旋转曲面","曲面定向","有向投影面积","第二型曲面积分"],"metadata":{"coverage":"full_bytes","image_semantic_reviewed":false,"original_path":"错题知识网络/assets/visual_wrong_questions/GS-726/explanation_01.png","original_sha256":"603928eff0711af4d4f1768d8f0bcfe9b1c31ddd9c39d88b0a139b0e67e2a619","personal_evidence":false,"role":"reference_only_not_mastery","size":1202275,"status":"verified","text_status":"text_unavailable_no_ocr"},"not_proof_of_same_error":true,"record_id":"source:1d74c33171acfd30d249b79f","source_refs":[{"path":"错题知识网络/个人知识点索引/source_cache/b88560cb85a39a37099d1e2c09ff71baf817e29941d73c6223e82f9d625515bb.json","sha256":"96c3a5120082dd0884dfd8b972c1333c45d3e15e501cde7689007b00cc6d540f"},{"path":"错题知识网络/assets/visual_wrong_questions/GS-726/explanation_01.png","sha256":"603928eff0711af4d4f1768d8f0bcfe9b1c31ddd9c39d88b0a139b0e67e2a619"}],"text":""},"source:3b92200ca0b6754fe9141e05":{"association":"learning_material_not_personal_error","formal_id":null,"kind":"general_learning_material","labels":["函数极限","无穷大量比较","有界函数乘无穷小","极限与连续"],"metadata":{"coverage":"full_bytes","image_semantic_reviewed":false,"original_path":"错题知识网络/assets/visual_wrong_questions/GS-019/question_01.png","original_sha256":"e7461825c4d467ad489dd00c75de7e663e473f60ea5fc15ba94789af74c60768","personal_evidence":false,"role":"reference_only_not_mastery","size":14960,"status":"verified","text_stat