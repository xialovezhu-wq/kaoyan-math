56b19c07dca038a9bd9","original_sha256":"06727baa25f4e20af18488d29f2c86009459a82bf3d32f20b6b4fda1f6b547ee","personal_evidence":false,"receipt_id":"MATH-ARCHIVE-5170dd1f83e6123416d7a1ef","role":"raw_unadjudicated_not_new_wrong_cause","selected_user_sequence":1,"selection":"first_complete_user_turn","status":"verified","terminal_outcomes":["recurrence_recorded"],"user_turn_cache":"错题知识网络/个人知识点索引/source_cache/e549c266d13dc4a2e3eea13ee16ad89f4edf8a8d2e982c04c05614f55c736d25.users.json","user_turn_cache_sha256":"e549c266d13dc4a2e3eea13ee16ad89f4edf8a8d2e982c04c05614f55c736d25","user_turn_count":4,"user_turn_provenance":[{"character_range":[0,397],"next_role":"assistant","previous_role":null,"raw_text_sha256":"fcb31df690be4c80426031a96505fbf6a552efcf23e95c1d087b4829b46a4bc0","role":"user","sequence":1},{"character_range":[0,302],"next_role":"assistant","previous_role":"assistant","raw_text_sha256":"8499b98da8e988c54fd53e02b08cc72178abb6b1b323d28fbcf3a62e9d8da03f","role":"user","sequence":3},{"character_range":[0,178],"next_role":"assistant","previous_role":"assistant","raw_text_sha256":"c5f3287a93b4bdff39ce55085e1f0142cc8636487edd7509b2718deeee7333c4","role":"user","sequence":5},{"character_range":[0,10],"next_role":null,"previous_role":"assistant","raw_text_sha256":"8c156bdfa7b1efc9ff1d2dad7dfda84096af94e4f8dbb138ddbf12add90c4d63","role":"user","sequence":7}]},"not_proof_of_same_error":true,"record_id":"source:a9c6f50cdf246261e6f2c6a5","source_refs":[{"path":"错题知识网络/个人知识点索引/source_cache/d680fcd17661dbbc1d7b5d42ecff3955b471946a0eed7c16a09eeffaf17dcad1.json","sha256":"2449b000b15715231741be556f21f3626e02f85d902c1b99fac4868d5863153a"}],"text":"/Users/xiazhibin/Documents/kaoyan-math/错题知识网络/可视化错题详情/高等数学/GS-762\\_102592椭球面奇异向量场通量.md 这道题我不知道如何下手。我只看出来了法向量朝外侧（即外侧为正），我其实不太懂法向量朝外侧是什么意思，但应该跟正负号相关吧？\n\n题目给出了椭球面方程，它的体积是 πabc。然后它让我求这个曲面积分，曲面积分我大概知道，比如如果知道 x² + y² + z² 等于什么，是可以直接代进去算的（比如等于 1 就可以直接代入，二重积分不行，但这里可以代）。\n\n这道题我也知道可能是用高斯公式：转换成 P 对 x 求偏导、Q 对 y 求偏导、R 对 z 求偏导，分子上变成 3。把 x² + y² + z² 提出去之后，转换成三重积分就是 3 倍的体积，体积是 πabc，最后结果是不是 3πabc？\n\n是不是这么算，还是怎么算？"},"source:c3486afa72818b3d0d996bcc":{"association":"learning_material_not_personal_error","formal_id":null,"kind":"general_learning_material","labels":["函数奇偶性","定积分","定积分性质","嵌套变上限积分","常数项对奇偶性的影响"],"metadata":{"coverage":"full_bytes","image_semantic_reviewed":false,"original_path":"错题知识网络/assets/visual_wrong_questions/GS-309/question_01.png","original_sha256":"75c81faf27ca7f50511d04dd86c924420326cb0a9de3918621a54fb5ee5ed64d","personal_evidence":false,"role":"reference_only_not_mastery","size":120705,"status":"verified","text_status":"text_unavailable_no_ocr"},"not_proof_of_same_error":true,"record_id":"source:c3486afa72818b3d0d996bcc","source_refs":[{"path":"错题知识网络/个人知识点索引/source_cache/e0e347a07978d4e3d7b092b4a887890f99ca0058ed2313e265c0c475c3af9866.json","sha256":"d67ef105c24e71d513a117067feebf211dc373ead5d72c23e3ecd2b57b156d4c"},{"path":"错题知识网络/assets/visual_wrong_questions/GS-309/question_01.png","sha256":"75c81faf27ca7f50511d04dd86c924420326cb0a9de3918621a54fb5ee5ed64d"}],"text":""}}}