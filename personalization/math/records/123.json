-GS-566]] | 高等数学 | 无穷级数 | 方法选择错误；过程跳步；概念混淆 | 先判型；相邻差识别；部分和定义；望远镜求和；method_gap:B4-CHAIN | 待复做 | `错题知识网络/错题卡/GS-566_138692相邻差望远镜判敛.md` |\n\n## 后续编译动作\n\n- 高频错因重复出现时，创建或更新 `wiki/error_patterns/`。\n- 第一动作重复出现时，创建或更新 `wiki/methods/` 或 `wiki/triggers/`。\n- 若本知识点已经有知识树来源，补充到对应 source summary 和专题页。\n- 若题目仍是粗标签或待精分，优先回到正式错题卡核对轻量字段，不在本页编造。\n\n## 入口\n\n- [[SRC-WRONGCARDS-INDEX_全量错题卡覆盖索引]]\n- [[MATHWIKI-COVERAGE-001_错题卡全量覆盖索引]]"},"source:9971a8d912c44038422e1ad5":{"association":"learning_material_not_personal_error","formal_id":null,"kind":"general_learning_material","labels":["三角不等式","乘积配项","二次因式整除","二次型","二重根条件","交叉相乘","交错级数","交错级数分组","函数极限","动作链断裂","单调有界","单调有界准则","叉乘","变上限积分","变限积分","固定点候选筛选","多项式整除","多项式零点","奇偶项拆分","定积分","导数定义","导数定义拆差商","数列极限","数字特征","有限非零极限","条件收敛","极限","构造比值数列","比值数列","比值比较","洛必达前置化简","洛必达前置化简不足","洛必达消积分号","相邻项比值比较","矩阵运算","积分变量与外部参数","等比压缩","等比压缩逻辑","绝对收敛","自变量增量","调和级数","调和级数比较","递推数列","通项趋零","高斯积分","高斯积分公式","黎曼和"],"metadata":{"concept_locations":{"三角不等式":[12],"乘积配项":[11,33],"二次因式整除":[21],"二次型":[22],"二重根条件":[21],"交叉相乘":[39],"交错级数":[38],"交错级数分组":[38],"函数极限":[35],"动作链断裂":[21],"单调有界":[19],"单调有界准则":[19],"叉乘":[39],"变上限积分":[20,37],"变限积分":[37],"固定点候选筛选":[34],"多项式整除":[21],"多项式零点":[35],"奇偶项拆分":[38],"定积分":[23],"导数定义":[36],"导数定义拆差商":[36],"数列极限":[19],"数字特征":[23],"有限非零极限":[35],"条件收敛":[11,33,38],"极限":[19,35,36,37,40],"构造比值数列":[34],"比值数列":[34],"比值比较":[13],"洛必达前置化简":[20],"洛必达前置化简不足":[20],"洛必达消积分号":[37],"相邻项比值比较":[13],"矩阵运算":[22],"积分变量与外部参数":[20],"等比压缩":[34],"等比压缩逻辑":[34],"绝对收敛":[11,33],"自变量增量":[36],"调和级数":[10],"调和级数比较":[10],"递推数列":[19],"通项趋零":[11],"高斯积分":[20],"高斯积分公式":[20],"黎曼和":[23]},"coverage":"full_bytes","image_semantic_reviewed":false,"original_path":"数学一回滚复习系统/学习记录/2026-06-10.md","original_sha256":"d147869a9eec10734b374f433da15dea925362289cbfc2491387c2439da5fe8e","personal_evidence":false,"reference_line_count":60,"reference_text_path":"错题知识网络/个人知识点索引/source_cache/d147869a9eec10734b374f433da15dea925362289cbfc2491387c2439da5fe8e.reference.txt","reference_text_sh