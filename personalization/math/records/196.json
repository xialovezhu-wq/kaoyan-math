role":"reference_only_not_mastery","size":420451,"status":"verified","text_status":"text_unavailable_no_ocr"},"not_proof_of_same_error":true,"record_id":"source:22ed0bf5160b91c3bcfe991b","source_refs":[{"path":"错题知识网络/个人知识点索引/source_cache/c4353a0932c014a05a2d4eadf810b93d3b7c055ab11c1f9da4b278a9d20971db.json","sha256":"77cf29582eea9c76d3860047882470d3453a12d8392af3f4d23829978584686e"},{"path":"错题知识网络/assets/visual_wrong_questions/GS-734/solution_01.png","sha256":"246d3423307fba87d39aec4352bf0a1c8878ecdffeb6e8fd112b5d320e32df45"}],"text":""},"source:30e51384ce9ce577c9f87dcf":{"association":"learning_material_not_personal_error","formal_id":null,"kind":"general_learning_material","labels":[],"metadata":{"coverage":"full_bytes","image_semantic_reviewed":false,"original_path":"错题知识网络/assets/visual_wrong_questions/MN4-GS-CH01-278/question_01.png","original_sha256":"3ac43b521d8097f39dfcb67fedd95c0755b891b8109fb4aae0b362b53391584d","personal_evidence":false,"role":"reference_only_not_mastery","size":48389,"status":"verified","text_status":"text_unavailable_no_ocr"},"not_proof_of_same_error":true,"record_id":"source:30e51384ce9ce577c9f87dcf","source_refs":[{"path":"错题知识网络/个人知识点索引/source_cache/9017310da6feb3be9fbd414ad764accf6d02a7fe32c0d6df894b6725ef7b353a.json","sha256":"c26697dc5457d47e0f1f9be1ecf34b642bb181669c641f650acabc41bff5aec7"},{"path":"错题知识网络/assets/visual_wrong_questions/MN4-GS-CH01-278/question_01.png","sha256":"3ac43b521d8097f39dfcb67fedd95c0755b891b8109fb4aae0b362b53391584d"}],"text":""},"source:31ba05b4d2341fab7eda93de":{"association":"learning_material_not_personal_error","formal_id":null,"kind":"general_learning_material","labels":["和、差与线性组合的卷积型公式"],"metadata":{},"not_proof_of_same_error":true,"record_id":"source:31ba05b4d2341fab7eda93de","source_refs":[{"path":"错题知识网络/wiki/topics/knowledge_clusters/MATHWIKI-KNOWLEDGE-700_和、差与线性组合的卷积型公式.md","sha256":"6c8d59b397d3745cb69a70a40795e830443db654d731f5ce7ffc4c27ebf233a4"}],"text":"# 和、差与线性组合的卷积型公式\n\n本页是由五份讲义来源提炼的通用知识锚点，不含本人作答证据；关联题只表示知识点归属，不推断错因、掌握度或复习状态。\n\n## 范围\n\n把Y反解成z-X或一般线性式，在联合密度中代入并对剩余变量积分。\n\n## 核心表达\n\n- f_{X+Y}(z)=∫f_{X,Y}(x,z−x)dx；独立时联合密度再分解为f_X(x)f_Y(z−x)。\n\n## 条件与边界\n\n独立时才可把联合密度分成边缘乘积；变换含缩放时必须有绝对Jacobian因子。\n\n## 来源\n\n| 来源 | 文件 | PDF页 | 书内页 | 定位短语 |\n|---|---|---|---|---|\n| FH-A | 2027考研数学--概率统计就这点事-强化篇--方浩.pdf | 79–83 | 74–78 | 卷积公式 |\n| ZY-P | 《2026张宇数学基础30讲 概率论与数理统计分册》.pdf | 92 | 80 | 卷积公式 |\n\n## 上级知识节点\n\n- 二维随机变量（候选上级，未作为已接受的 is-a 边）\n- 随机变量分布（候选上级，未作为已接受的 is-a 边）\n\n## 知识关系（提案，未生效）\n\n- prerequisite → PR06.04：建议的学习／调用前置，不是逻辑充分条件；允许其他学习顺序。\n\n## 关联正式题\n\n暂无关联正式题。\n\n## 来源标识\n\n- 参考包运行标识：`A-math-anchor-distribution-20260909-01`\n- 包内定位：`PR06.03`（仅用于本包定位，不是本地正式 ID）\n- 来源范围：`main`；锚点类型：`knowledge`"},"source:7fb1a6a6d487b1493237d5d3":{"association":"learning_material_not_personal_error","formal_id":null,"kind":"accepted_conversation_excerpt","labels":["向量代数与空间解析几何","向量单位化","定向曲面","梯度与法向量","隐式曲面"],"metadata":{"capture_ids":["MFI-CAP-83912332632dd306b768146b"],"closeout_id":"MFI-CLOSE-a771ee2111457ce9ae5143ee","conversation_complete":true,"coverage":"full_bytes","files":[{"path":"/Users/xiazhibin/Documents/kaoyan-math/数学一回滚复习系统/快速入库来源/2026-08-27/MATHPKG-60537c61479a40f91ae86e0e/conversation.json","sha256":"bb320dcdadb2841850539da661d50522f8c1e9c761b4e9235651021f7a09221c","status":"verified","text_status":"available"},{"path":"/Users/xiazhibin/Documents/kaoyan-math/数学一回滚复习系统/快速入库来源/2026-08-27/MATHPKG-60537c61479a40f91ae86e0e/source.json","sha256":"3e08256a31e7a45ec209c92b1f9c5f2afa615884bb52d265e876af411beb9ee9","status":"verified","text_status":"available"},{"path":"/Volumes/T9-Data/03_数学/资料库/原始会话资料/2026-08-27/MATHPKG-60537c61479a40f91ae86e0e/attachments/question_image_01.png","sha256":"0354d5881d2e9cdc9502ed2a5c67aa337f0a0f1524732323de1d7b6797b2c9d8","status":"verified","text_status":"text_unavailable_no_ocr"},{"path":"/Volumes/T9-Data/03_数学/资料库/原始会话资料/2026-08-27/MATHPKG-60537c61479a40f91ae86e0e/attachments/solution_image_01.png","sha256":"f0528de4819e6