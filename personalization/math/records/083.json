作\n\n- 若本标签形成稳定第一动作或反复错因，再升级为深度概念、方法、错因或触发页。\n- 缺少个人作答证据时只保留索引关系，不反推用户错因。\n\n## 入口\n\n- [[SRC-WRONGCARDS-INDEX_全量错题卡覆盖索引]]\n- [[MATHWIKI-COVERAGE-MATRIX_错题卡多维编译矩阵]]"},"source:ea42eaf346fff09b2716a4c8":{"association":"learning_material_not_personal_error","formal_id":null,"kind":"general_learning_material","labels":["三重积分","二次曲面","多元函数积分学","球面坐标"],"metadata":{"coverage":"full_bytes","image_semantic_reviewed":false,"original_path":"错题知识网络/assets/visual_wrong_questions/GS-670/question_01.png","original_sha256":"5aac51663b9de82200a6cfec8861e673fcc84f6ec54f8a42375ab3ca15c97c15","personal_evidence":false,"role":"reference_only_not_mastery","size":134362,"status":"verified","text_status":"text_unavailable_no_ocr"},"not_proof_of_same_error":true,"record_id":"source:ea42eaf346fff09b2716a4c8","source_refs":[{"path":"错题知识网络/个人知识点索引/source_cache/216e783858ba76066d98417ba3c79bd9ac52b5cc0661eecde37e0a2d79057467.json","sha256":"51381b9af157fd2b3fed92ea9c51366aede4cda2096add5894df55ce8e5cb51f"},{"path":"错题知识网络/assets/visual_wrong_questions/GS-670/question_01.png","sha256":"5aac51663b9de82200a6cfec8861e673fcc84f6ec54f8a42375ab3ca15c97c15"}],"text":""},"source:fc151a009176df6b10afbd5f":{"association":"learning_material_not_personal_error","formal_id":null,"kind":"accepted_capture_reference","labels":["三角恒等变形","变上限积分","定积分","定积分应用","曲线弧长"],"metadata":{"capture_ids":["MFI-CAP-a95a2a3b6a68aa5b61f4a2cb"],"closeout_id":"MFI-CLOSE-dba3000eefe30b6a9dc382f0","conversation_complete":false,"conversation_status":"legacy_conversation_missing","coverage":"full_bytes","files":[{"path":"/Volumes/T9-Data/03_数学/资料库/原始会话资料/2026-07-21/MATHLEGACY-6556b22704384f1abfc05376/ledger-events.jsonl","sha256":"6240ebe6ff32f287254db070f71cda73612c85df1a166b4aa277168a561881ad","status":"verified","text_status":"available"}],"original_path":"/Volumes/T9-Data/03_数学/资料库/原始会话资料/2026-07-21/MATHLEGACY-6556b22704384f1abfc05376","original_sha256":"431b563fca68d71305f9e29064f5ab49b53d11be8d8df3d9c6a33b107d61de02","personal