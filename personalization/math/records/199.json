rce_cache/35632841dcfce78953e32de0975c05b26e7fcbd21bff85287a01515d73fe63d7.json","sha256":"8717128f1cd1b189b4ddb9f2de4f45ffa340749b5f1e58400a1395f7f2b95fbd"},{"path":"错题知识网络/assets/visual_wrong_questions/GS-255/question_03.png","sha256":"f6cea4887a7ea4c05381947794d9e82093ba7cd4abbc648f6caa67dfdc0192d3"}],"text":""},"source:413ec71954f83b8ecfe91a84":{"association":"learning_material_not_personal_error","formal_id":null,"kind":"general_learning_material","labels":["条件化计算数字特征"],"metadata":{},"not_proof_of_same_error":true,"record_id":"source:413ec71954f83b8ecfe91a84","source_refs":[{"path":"错题知识网络/wiki/topics/knowledge_clusters/MATHWIKI-KNOWLEDGE-723_条件化计算数字特征.md","sha256":"82a5c9ae40433ca25296397bc59a04dab862a41065287c14bfb4cdb11883a2e0"}],"text":"# 条件化计算数字特征\n\n本页是由五份讲义来源提炼的通用知识锚点，不含本人作答证据；关联题只表示知识点归属，不推断错因、掌握度或复习状态。\n\n## 范围\n\n先在每个条件状态求E或Var，再用总期望／总方差合成随机混合模型。\n\n## 条件与边界\n\n混合方差不是各条件方差的简单加权平均，还包括条件均值的波动。\n\n## 来源\n\n| 来源 | 文件 | PDF页 | 书内页 | 定位短语 |\n|---|---|---|---|---|\n| FH-A | 2027考研数学--概率统计就这点事-强化篇--方浩.pdf | 96–111 | 91–106 | 期望 |\n| ZY-P | 《2026张宇数学基础30讲 概率论与数理统计分册》.pdf | 185–189 | 173–177 | 亚当夏娃公式 |\n\n## 上级知识节点\n\n- 数字特征（候选上级，未作为已接受的 is-a 边）\n- 条件分布（候选上级，未作为已接受的 is-a 边）\n\n## 知识关系（提案，未生效）\n\n暂无关系提案。\n\n## 关联正式题\n\n暂无关联正式题。\n\n## 来源标识\n\n- 参考包运行标识：`A-math-anchor-distribution-20260909-01`\n- 包内定位：`PR07.16`（仅用于本包定位，不是本地正式 ID）\n- 来源范围：`main`；锚点类型：`knowledge`"},"source:5057a6a4a5ca534c7fc91085":{"association":"learning_material_not_personal_error","formal_id":null,"kind":"accepted_capture_reference","labels":["变上限积分求导","定积分比较","导数符号表","正弦基本不等式","驻点与极值"],"metadata":{"capture_ids":["MFI-CAP-2859be1d2c85e77f830aecda"],"closeout_id":"MFI-CLOSE-c8ed3bdbae64d3aa73d2aa2f","conversation_complete":false,"conversation_status":"legacy_conversation_missing","coverage":"full_bytes","files":[{"path":"/Volumes/T9-Data/03_数学/资料库/原始会话资料/2026-07-28/MATHLEGACY-b8fe93931ae7183966fb625a/ledger-events.jsonl","sha256":"59f1810c384d227cf6085dd365ce8a16b1a4a82e2c623167c43ab3d0d8b95f7f",