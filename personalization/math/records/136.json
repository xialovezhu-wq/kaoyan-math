立正确（过程未核验） | `错题知识网络/错题卡/GS-668_102610球体截面球面坐标.md` |"},"source:b1fd869eecb4d27ca882ca73":{"association":"learning_material_not_personal_error","formal_id":null,"kind":"general_learning_material","labels":["参数方程求导","向量代数与空间解析几何","方向向量","空间曲线切线与法平面","空间直线与平面"],"metadata":{"coverage":"full_bytes","image_semantic_reviewed":false,"original_path":"错题知识网络/assets/visual_wrong_questions/GS-646/question_01.png","original_sha256":"e943d11cf95e61faa50f3c8662116680015187f9b08fa616f78ec72090b37bc0","personal_evidence":false,"role":"reference_only_not_mastery","size":103110,"status":"verified","text_status":"text_unavailable_no_ocr"},"not_proof_of_same_error":true,"record_id":"source:b1fd869eecb4d27ca882ca73","source_refs":[{"path":"错题知识网络/个人知识点索引/source_cache/81e4627e68018eee5c7dfd44d9340452440503c7b18e32293ad694f45593d51a.json","sha256":"e524fc386f9d85e4b8ba1d4356cb40137714a0b86f4141a2156c52aa75c9e625"},{"path":"错题知识网络/assets/visual_wrong_questions/GS-646/question_01.png","sha256":"e943d11cf95e61faa50f3c8662116680015187f9b08fa616f78ec72090b37bc0"}],"text":""},"source:d6ac6678c063f27b5a6a8c01":{"association":"learning_material_not_personal_error","formal_id":null,"kind":"general_learning_material","labels":["一元函数微分学应用","反向构造原函数","多项式零点","端点同值","系数条件与积分矩","罗尔定理"],"metadata":{"coverage":"full_bytes","image_semantic_reviewed":false,"original_path":"错题知识网络/assets/visual_wrong_questions/GS-220/question_01.png","original_sha256":"8d90637d1f51237339037677aa2cc2089c32f686f22a11fafc19b58290ee83c1","personal_evidence":false,"role":"reference_only_not_mastery","size":85364,"status":"verified","text_status":"text_unavailable_no_ocr"},"not_proof_of_same_error":true,"record_id":"source:d6ac6678c063f27b5a6a8c01","source_refs":[{"path":"错题知识网络/个人知识点索引/source_cache/5d52aa2602ad770f6bc65ead5688a55c945ba38e4e4de8e45fddb045988b9354.json","sha256":"b2c89ff1e59d410982430e5252a4388680672c38f0dfb39efccb76940d93d337"},{"path":"错题知识网络/assets/visual_wrong_questions/GS-220/question_01.png","sha256":"8d90637