d150b51d65fe3f183bdfa63320dfe7ad8692a081254b04b7ff6f6931d87608","formal_history":{"evidence_origin":"user_confirmed","mastery_history":["2026-06-28 掌握度 3/5：凑微分入口能想到，但整体变量识别、三角换元整体替换和幂三角积分链条不稳。","2026-07-11 待评分：本轮仅做知识点与关系语义复核，没有新增用户作答过程，不能产生掌握度判断。"],"missed_action":"凑微分后没有把 \\(x^2\\) 作为整体变量，也没有想到令 \\(x^2=\\sin t\\)。","status":"待复做","wrong_history":["2026-06-28 第1次错：计算 \\(\\int_0^1 x(1-x^4)^{3/2}\\,dx\\) 时，想到凑微分但没有继续把 \\(x^2\\) 当作整体变量；没有把 \\(1-x^4\\) 写成 \\(1-(x^2)^2\\)，也没有触发 \\(x^2=\\sin t\\) 的三角换元和 \\(\\cos^4t\\) 的 Wallis 积分。"],"wrong_point":"看到 \\(x(1-x^4)^{3/2}\\) 时，虽然想到凑微分，但没有继续把 \\(x^2\\) 当成整体变量；应先写 \\(x\\,dx=\\frac12d(x^2)\\)，同时把 \\(1-x^4\\) 改写为 \\(1-(x^2)^2\\)，再令 \\(x^2=\\sin t\\) 转成 \\(\\frac12\\int_0^{\\pi/2}\\cos^4t\\,dt\\)。"},"formal_id":"GS-636","history_may_override_current":false,"knowledge":["定积分","一元函数积分学的计算","第一类换元","第二类换元","整体凑微分","三角换元","华里士公式","三角恒等变形","幂三角积分"],"review_events":[],"scheduling":{"下次复习日期":"2026-06-28","复习单元ID":"MATH1-GS-WQ-GS636","复习状态":null,"当前间隔天数":0,"掌握度":3,"最近复发日期":null,"证据阶段":null,"调度优先级":null,"连续延迟成功次数":null},"schema_version":"math-live-learning-state-v1","source_stamps":{"concept_directory":{"ctime_ns":1786566513464499949,"inode":43247501,"mtime_ns":1786566513464499949},"数学一回滚复习系统/复习单元.json":{"ctime_ns":1788330434969648987,"inode":189761659,"mtime_ns":1788330434961667258,"size":1582119},"数学一回滚复习系统/复习记录.jsonl":{"ctime_ns":1788328612946477885,"inode":34903167,"mtime_ns":1788328612946477885,"size":399399}},"source_version":"edfcfe120b94fc88a60111f4d81fdb36b5ff7dc227f4db27814190e0dfcf7029"}
