{"concepts":[{"concept_id":"MATHWIKI-KNOWLEDGE-002","label":"定积分","path":"错题知识网络/wiki/topics/knowledge_clusters/MATHWIKI-KNOWLEDGE-002_定积分.md","sha256":"c4c4027db908f16fd47d3b21005f7b386a705d7f0c39fa04f3cd601bf9a557c2"},{"concept_id":"MATHWIKI-KNOWLEDGE-035","label":"定积分应用","path":"错题知识网络/wiki/topics/knowledge_clusters/MATHWIKI-KNOWLEDGE-035_定积分应用.md","sha256":"bdf04a66f6c1dc2b0ed61b550e8861a73aa57cba52f276c935e815d78f01287a"},{"concept_id":"MATHWIKI-KNOWLEDGE-166","label":"函数平均值","path":"错题知识网络/wiki/topics/knowledge_clusters/MATHWIKI-KNOWLEDGE-166_函数平均值.md","sha256":"21d8798383dc46a614b4493c41a5d35d7dc47a954aa165b4be8092d818ac0fb3"},{"concept_id":"MATHWIKI-KNOWLEDGE-080","label":"三角换元","path":"错题知识网络/wiki/topics/knowledge_clusters/MATHWIKI-KNOWLEDGE-080_三角换元.md","sha256":"a7d375593ca44943c871ec87ddd7b39ff2108c2cb7088d87989622a1de1e7e54"},{"concept_id":"MATHWIKI-KNOWLEDGE-043","label":"三角恒等变形","path":"错题知识网络/wiki/topics/knowledge_clusters/MATHWIKI-KNOWLEDGE-043_三角恒等变形.md","sha256":"a47d6cc35b17bfedbfaa7469a7d4d6c382cf7edbb7afb8ca32aaac9481e33f75"}],"formal_card_path":"错题知识网络/错题卡/GS-592_57967平均值三角换元.md","formal_card_sha256":"adc0ab385d1af323f4b6288800bf124e490c9048230a40f7813126af23a46b27","formal_history":{"evidence_origin":"legacy_unclassified","mastery_history":["2026-06-11 用户评分 3.5/5：平均值公式已掌握，但“根式结构→三角换元→特殊角端点→降幂积分”的动作链不够自动化；status 保持待复做。"],"missed_action":"没有把根式结构和特殊角端点转成三角换元，而是把 \\(dx/\\sqrt{1-x^2}\\) 看成 \\(d(\\arcsin x)\\) 后走分部积分","status":"待复做","wrong_history":["2026-06-11 第1次错：平均值公式判断没问题，但看到 \\(\\frac{x^2}{\\sqrt{1-x^2}}\\) 和端点 \\(\\frac12,\\frac{\\sqrt3}{2}\\) 时，没有第一时间触发 \\(x=\\sin t\\) 的三角换元，误把入口放到 \\(d(\\arcsin x)\\) 与分部积分上，导致计算路线变复杂。"],"wrong_point":"平均值公式会用，但没有把 \\(\\sqrt{1-x^2}\\) 与端点 \\(\\frac12,\\frac{\\sqrt3}{2}\\) 识别为三角换元信号；应先令 \\(x=\\sin t\\)，把积分化为 \\(\\int_{\\pi/6}^{\\pi/3}\\sin^2 t\\,dt\\)，而不是优先走 \\(d(\\arcsin x)\\) 后分部积分的复杂路线。"},"formal_id":"GS-592","history_may_override_current":false,"knowledge":["定积分","定积分应用","函数平均值","三角换元","三角恒等变形"],"review_events":[],"scheduling":{"下次复习日期":"2026-06-12","复习单元ID":"MATH1-GS-WQ-GS592","复习状态":null,"当前间隔天数":1,"掌握度":3,"最近复发日期":"2026-06-11","证据阶段":null,"调度优先级":null,"连续延迟成功次数":null},"schema_version":"math-live-learning-state-v1","source_stamps":{"concept_directory":{"ctime_ns":1786566513464499949,"inode":43247501,"mtime_ns":1786566513464499949},"数学一回滚复习系统/复习单元.json":{"ctime_ns":1788330434969648987,"inode":189761659,"mtime_ns":1788330434961667258,"size":1582119},"数学一回滚复习系统/复习记录.jsonl":{"ctime_ns":1788328612946477885,"inode":34903167,"mtime_ns":1788328612946477885,"size":399399}},"source_version":"6defdf156dc9ea4e6d1dcf2c2d2ca80025e5dfc57ac9164cec1f86d862b6c772"}
