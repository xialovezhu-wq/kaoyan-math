697","history_may_override_current":false,"knowledge":["第一类换元","变限积分","变上限积分","复合函数求导","渐近线","等价无穷小"],"review_events":[],"scheduling":null,"schema_version":"math-live-learning-state-v1","source_stamps":{"concept_directory":{"ctime_ns":1786566513464499949,"inode":43247501,"mtime_ns":1786566513464499949},"数学一回滚复习系统/复习单元.json":{"ctime_ns":1788330434969648987,"inode":189761659,"mtime_ns":1788330434961667258,"size":1582119},"数学一回滚复习系统/复习记录.jsonl":{"ctime_ns":1788328612946477885,"inode":34903167,"mtime_ns":1788328612946477885,"size":399399}},"source_version":"eb2aca56713b48381509b5cfa03e7664f5f3a459b550ab2a8deb9fc376466a2d"}
