{"concepts":[{"concept_id":"MATHWIKI-KNOWLEDGE-002","label":"定积分","path":"错题知识网络/wiki/topics/knowledge_clusters/MATHWIKI-KNOWLEDGE-002_定积分.md","sha256":"c4c4027db908f16fd47d3b21005f7b386a705d7f0c39fa04f3cd601bf9a557c2"},{"concept_id":"MATHWIKI-KNOWLEDGE-009","label":"数列极限","path":"错题知识网络/wiki/topics/knowledge_clusters/MATHWIKI-KNOWLEDGE-009_数列极限.md","sha256":"63070af8bb1bf5d1d88df58a8c228852dee718469f92b03722c3e4fb0375d476"},{"concept_id":"MATHWIKI-KNOWLEDGE-083","label":"夹逼准则","path":"错题知识网络/wiki/topics/knowledge_clusters/MATHWIKI-KNOWLEDGE-083_夹逼准则.md","sha256":"79bf344c9987b082eacca0fa410fbc3be126a112c0af5ae2a1513bec7f5feabd"},{"concept_id":"MATHWIKI-KNOWLEDGE-068","label":"定积分不等式","path":"错题知识网络/wiki/topics/knowledge_clusters/MATHWIKI-KNOWLEDGE-068_定积分不等式.md","sha256":"a0a73f47d6f4743a9fd965bd572040fa225114131739645b401cf3cf2013437c"}],"formal_card_path":"错题知识网络/错题卡/GS-721_57781积分夹逼极限.md","formal_card_sha256":"61a7e3bc26e9c548a7b713c993086063700939e499ca841f879bac8084d18343","formal_history":{"evidence_origin":"user_confirmed","mastery_history":["2026-07-26 AI评分 2/5：能识别分部积分在形式上可用，并在讲解后复述夹逼路线；但“非负积分极限先比较放缩”的入口尚未通过独立完整复做验证。"],"missed_action":"未先检查被积函数能否被一个可积且积分趋零的简单函数控制，直接进入分部积分。","status":"待复做","wrong_history":["2026-07-26 第1次错：面对区间 \\([0,1]\\) 上含 \\(x^n\\) 的非负积分极限，优先尝试分部积分求精确表达式，没有先寻找一个积分趋于零的简单上界；分部后出现抵消结构，因而无法收口。"],"wrong_point":"证明积分趋于零时没有先检查被积函数的符号与简单上界。由于 \\(x\\in[0,1]\\) 时 \\(1+x\\ge1\\)，可直接得到 \\(0\\le\\frac{x^n}{1+x}\\le x^n\\)；积分上界为 \\(1/(n+1)\\)，已经足够由夹逼准则收口，无需精确计算原积分。"},"formal_id":"GS-721","history_may_override_current":false,"knowledge":["定积分","数列极限","夹逼准则","定积分不等式"],"review_events":[],"scheduling":{"下次复习日期":"2026-07-27","复习单元ID":"MATH1-GS-WQ-GS721","复习状态":"待首次延迟复做","当前间隔天数":1,"掌握度":3,"最近复发日期":"2026-07-26","证据阶段":null,"调度优先级":"高","连续延迟成功次数":0},"schema_version":"math-live-learning-state-v1","source_stamps":{"concept_directory":{"ctime_ns":1786566513464499949,"inode":43247501,"mtime_ns":1786566513464499949},"数学一回滚复习系统/复习单元.json":{"ctime_ns":1788330434969