1678edc96f9b5a8fa6cf6d2bb25afa13b120e3060d1d010255","formal_history":{"evidence_origin":"user_confirmed","mastery_history":["2026-07-11 待评分：本轮仅做知识点与关系语义复核，没有新增用户作答过程，不能产生掌握度判断。"],"missed_action":"把系数和整体硬套比值法，端点失效后没有回到原级数拆成熟悉级数。","status":"待复做","wrong_history":["2026-05-30 第1次错：把系数为两个不同类型表达式之和的幂级数 $\\left(\\frac1{n\\ln n}+\\frac1{2^n}\\right)x^n$ 当整体硬套比值法，端点 $x=1$ 处卡住；没有拆成 $\\sum\\frac{x^n}{n\\ln n}$ 与 $\\sum\\frac{x^n}{2^n}$ 分别求收敛域再取交集。整体半径 $R=1$ 与 $x=-1$ 交错部分（莱布尼茨收敛）都判对了，缺的是端点整体判别失效时回到原级数拆成熟悉级数判断。"],"wrong_point":"系数为\"两个不同性质表达式之和\"的幂级数，端点处整体比值法失效后没有拆开判断。正确做法：拆成 $\\sum_{n\\ge2}\\frac{x^n}{n\\ln n}$（$R=1$，$x=1$ 处为广义调和 $\\sum\\frac1{n\\ln n}$（$p=1$）发散，$x=-1$ 处交错由莱布尼茨收敛，收敛域 $[-1,1)$）与 $\\sum_{n\\ge2}\\frac{x^n}{2^n}$（等比型，收敛域 $(-2,2)$），再取交集 $[-1,1)\\cap(-2,2)=[-1,1)$。关键：端点整体判别法失效时，回到原级数把通项拆成已知类型级数（广义调和 / 等比 / 交错）分别判。"},"formal_id":"GS-518","history_may_override_current":false,"knowledge":["无穷级数","幂级数","幂级数收敛域","级数拆项","广义调和级数","p级数","交错级数","莱布尼茨判别法","等比级数"],"review_events":[],"scheduling":{"下次复习日期":"2026-05-31","复习单元ID":"MATH1-GS-WQ-GS518","复习状态":null,"当前间隔天数":1,"掌握度":3,"最近复发日期":"2026-05-30","证据阶段":null,"调度优先级":null,"连续延迟成功次数":null},"schema_version":"math-live-learning-state-v1","source_stamps":{"concept_directory":{"ctime_ns":1786566513464499949,"inode":43247501,"mtime_ns":1786566513464499949},"数学一回滚复习系统/复习单元.json":{"ctime_ns":1788330434969648987,"inode":189761659,"mtime_ns":1788330434961667258,"size":1582119},"数学一回滚复习系统/复习记录.jsonl":{"ctime_ns":1788328612946477885,"inode":34903167,"mtime_ns":1788328612946477885,"size":399399}},"source_version":"30a2b2f1c5a8a1859522502c2421d2e5cf60563dd9c73c05e9a0fd4f2aebd3fb"}
