    "calculation_method": {
      "formal_card_scope": "用当前错题知识网络/scripts/wrongnet.py 读取错题卡，保留 GS/LA/PR-数字 的 831 个唯一正式 ID。",
      "exact_sha_carry_forward": "旧 M192 provenance 为 DECISIONS_TARGET 或 PLAN_TARGET_ONLY，且当前卡字节 SHA256 与 M192 card_sha256 完全相同。",
      "semantic_payload_comparison": {
        "frontmatter_fields": [
          "title",
          "subject",
          "chapter",
          "question_type",
          "wrong_point",
          "knowledge",
          "error_causes",
          "methods",
          "traps",
          "answer",
          "method_gap"
        ],
        "body": "比较旧版与当前正文，但排除 ## 关联卡片 段，避免纯关系展示改动被误判为题意或错因变化。",
        "boundary": "field_level_semantic_carry_forward_candidate 是只读差异启发式，不是新的正式 target-review receipt；PLAN_TARGET_ONLY 也不等于带明确 content_status 的 decisions verdict。"
      },
      "field_level_semantic_carry_forward_candidate": "旧 M192 target-level provenance 存在，且上述语义 payload 无变化；允许包含关系或非语义 SHA 漂移。",
      "current_semantic_review_gap": "当前 831 ID 减去 field-level carry-forward candidate；包含 428 automatic-only、30 新卡及 16 张旧 target-reviewed 后语义变化的卡。",
      "visual_evidence": "复用历史审计选择 primary visual record 的排序：linked_wrongnet、formal_card_enhanced、visual_gap_registered、suspect_wrongnet_mismatch、merged_into_wrongnet；只计实际存在并可哈希的 question_assets/solution_assets。",
      "first_batch_30": "12 张历史 M192 next_batch + 15 张新增 q+s + 3 张旧 decisions target 中 q+s 且语义变化字段最多的 A 优先级卡。GS-425 仅作为身份裁决例外。"
    },
